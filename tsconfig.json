{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": { "codemirror-all": ["./ui/vendor-src/codemirror-all.ts"] }
  },
  "include": ["main.js", "scripts", "server", "ui/src", "ui/vendor-src"]
}
